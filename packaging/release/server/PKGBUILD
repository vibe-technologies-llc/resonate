pkgname=resonate-server
_pkgname=resonate
_version=0.2.0
pkgver=${_version//-/}
pkgrel=1
pkgdesc='The Resonate sync server: keeps sealed records and introduces devices (needs an x86-64-v3 CPU)'
arch=('x86_64')
url='https://github.com/vibe-technologies-llc/resonate'
license=('AGPL-3.0-or-later')
depends=('gcc-libs' 'systemd')
makedepends=('rust' 'cargo' 'gcc' 'pkgconf')
conflicts=("$pkgname-git")
backup=('etc/resonate-server/resonate-server.env')
options=('!lto')
source=("$pkgname-$_version.tar.gz::$url/archive/refs/tags/v$_version.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$_pkgname-$_version"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname-$_version"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
  export RUSTFLAGS="-C target-cpu=x86-64-v3"
  cargo build --frozen --release --package resonate-server
}

package() {
  cd "$_pkgname-$_version"

  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/resonate-server" "$pkgdir/usr/bin/resonate-server"
  install -Dm644 packaging/server/resonate-server.service \
    "$pkgdir/usr/lib/systemd/system/resonate-server.service"
  install -Dm644 packaging/server/resonate-server.env \
    "$pkgdir/etc/resonate-server/resonate-server.env"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"
  install -Dm644 README.md "$pkgdir/usr/share/doc/resonate-server/README.md"
}
