pkgname=resonate-server-git
_pkgname=resonate
pkgver=0.1.0.r946.g2472b9b
pkgrel=1
pkgdesc='The Resonate sync server: keeps sealed records and introduces devices'
arch=('x86_64' 'aarch64')
url='https://github.com/vibe-technologies-llc/resonate'
license=('AGPL-3.0-or-later')
depends=('gcc-libs' 'systemd')
makedepends=('rust' 'cargo' 'gcc' 'pkgconf' 'git')
provides=('resonate-server')
conflicts=('resonate-server')
backup=('etc/resonate-server/resonate-server.env')
options=('!lto' '!debug')
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  local declared
  declared="$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -1)"
  declared="${declared//-/}"
  printf '%s.r%s.g%s' "$declared" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} -C target-cpu=native"
  cargo build --frozen --release --package resonate-server
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export RUSTFLAGS="${RUSTFLAGS:-} -C target-cpu=native"
  cargo test --frozen --release --package resonate-server
}

package() {
  cd "$_pkgname"

  install -Dm755 target/release/resonate-server "$pkgdir/usr/bin/resonate-server"
  install -Dm644 packaging/server/resonate-server.service \
    "$pkgdir/usr/lib/systemd/system/resonate-server.service"
  install -Dm644 packaging/server/resonate-server.env \
    "$pkgdir/etc/resonate-server/resonate-server.env"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"
  install -Dm644 README.md "$pkgdir/usr/share/doc/resonate-server/README.md"
}
