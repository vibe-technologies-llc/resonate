[Unit]
Description=Resonate sync server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/resonate-server/resonate-server.env
LoadCredential=certificate:/etc/resonate-server/fullchain.pem
LoadCredential=key:/etc/resonate-server/privkey.pem
ExecStart=/usr/bin/resonate-server --listen ${LISTEN} --certificate ${CREDENTIALS_DIRECTORY}/certificate --key ${CREDENTIALS_DIRECTORY}/key --store ${STATE_DIRECTORY}/records.sqlite --cache ${CACHE_DIRECTORY} $SERVER_ARGS
DynamicUser=yes
StateDirectory=resonate-server
CacheDirectory=resonate-server
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
