tracks-missing-from-albums = { $tracks ->
    [one] { $tracks } piste
   *[other] { $tracks } voies
} manquant de { $albums ->
    [one] { $albums } album
   *[other] { $albums } albums
}
releases-by-artists-not-held = { $releases ->
    [one] { $releases } libération
   *[other] { $releases } rejets
} par { $artists ->
    [one] { $artists } artiste
   *[other] { $artists } artistes
} non détenu
missing = Manque
bring-back = Ramener { $count } renvoyé
tracks = Pistes
releases = Sorties
missing-from-album = { $count } manquant
releases-unheld = { $count ->
    [one] { $count } libération
   *[other] { $count } rejets
}
disc = Disque { $disc }
disc-eyebrow = Dénomination commune { $disc }
tracks-listed-short = { $listed } de { $counted } voies énumérées; type à restreindre au reste
releases-listed-short = { $listed } des rejets de { $counted } énumérés; type à réduire au reste
