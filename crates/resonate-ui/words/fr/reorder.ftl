moving-reaching = Faites glisser une rangée vers l’endroit où elle devrait jouer. Atteindre une rangée — { $reach-above } ou { $reach-below }. Atteindre plus d’entre eux — { $widen-above } ou { $widen-below }
moving-further = Pour aller plus loin — { $reach-first }, { $reach-last }, { $reach-page-above } ou { $reach-page-below }. Pour atteindre chaque ligne — { $reach-everything }
moving-acting = Déplacez ce qui est atteint — { $raise-row } ou { $lower-row }. Jouez-le — { $play-reached }. Enlevez-le — { $drop-reached }. Ouvrez son menu — menu ou { $open-menu }.
moving-hint = { $reaching }. { $further }. { $acting }
one-place-sooner = Jouer ce qui est atteint plus tôt — { $keys }
one-place-later = Jouer ce qui est atteint plus tard — { $keys }
titled-and-more = { $title } et { $more } plus
and-more = et { $more } plus
