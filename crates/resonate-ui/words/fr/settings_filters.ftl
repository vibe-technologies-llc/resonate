nothing-hidden = Rien n’est caché. Une chanson cachée dans son menu attend ici, avec ses pièces, ses favoris et ses playlists gardées, jusqu’à ce qu’elle soit montrée à nouveau.
show-again = Afficher à nouveau
choose-the-formats-to-include-in = Choisissez les formats à inclure dans votre bibliothèque
select-all = Tout sélectionner
clear-selection = Effacer la sélection
changes-apply-to-library-listings-immediately = Les modifications s’appliquent aux listes de bibliothèques immédiatement. Les fichiers exclus restent sur le disque dur et dans le catalogue.
songs-hidden = { $counted ->
    [one] { $counted } la chanson est cachée.
   *[other] { $counted } chansons sont cachées.
}
songs-hidden-and-listed = { $counted ->
    [one] { $counted } la chanson est cachée.
   *[other] { $counted } chansons sont cachées; les premières { $shown } par titre sont listées.
}
show-them-all-again = Montre-les à nouveau.
list-them-in-tracks = Énumérez-les dans les pistes
minimum-length-in-seconds = Durée minimale en secondes
enter-a-value-from-0-to = Saisissez une valeur de 0 à 600 secondes (10 minutes), puis appuyez sur Entrée pour appliquer. Zéro inclut chaque longueur; un minimum positif exclut les pistes dont la longueur est inconnue.
enter-a-minimum-length-between-0 = Saisissez une longueur minimale entre 0 et 600 secondes
exclude-extension = Exclure { $extension } de la bibliothèque
include-extension = Inclure { $extension } dans la bibliothèque
included-of = { $selected } de { $offered } inclus
show-in-the-library-again = Afficher à nouveau { $title } dans la bibliothèque
