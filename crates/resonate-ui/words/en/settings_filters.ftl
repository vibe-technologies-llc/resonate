nothing-hidden = Nothing is hidden. A song hidden from its menu waits here, with its plays, favourite and playlists kept, until it is shown again.
show-again = Show again
choose-the-formats-to-include-in = Choose the formats to include in your library
select-all = Select all
clear-selection = Clear selection
changes-apply-to-library-listings-immediately = Changes apply to library listings immediately. Excluded files stay on disk and in the catalog.
songs-hidden = { $counted ->
    [one] { $counted } song is hidden.
   *[other] { $counted } songs are hidden.
}
songs-hidden-and-listed = { $counted ->
    [one] { $counted } song is hidden.
   *[other] { $counted } songs are hidden; the first { $shown } by title are listed.
}
show-them-all-again = Show them all again
list-them-in-tracks = List them in Tracks
minimum-length-in-seconds = Minimum length in seconds
enter-a-value-from-0-to = Enter a value from 0 to 600 seconds (10 minutes), then press Enter to apply. Zero includes every length; a positive minimum excludes tracks whose length is unknown.
enter-a-minimum-length-between-0 = Enter a minimum length between 0 and 600 seconds
exclude-extension = Exclude .{ $extension } from the library
include-extension = Include .{ $extension } in the library
included-of = { $selected } of { $offered } included
show-in-the-library-again = Show { $title } in the library again
