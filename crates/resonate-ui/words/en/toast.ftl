could-not = Couldn't { $doing }
could-not-because = Couldn't { $doing } — { $why }
unknown-layout-field = the layout asks for { $field }, which a track isn't known by
layout-syntax = a brace in the layout isn't closed or doubled
layout-escapes = the layout reaches outside the folder it files under
already-walking = another library task is still running
already-asking = another Resonate is already asking the same services
unreachable = the service couldn't be reached
refused = the service turned the request down
unreadable-or-unwritten = a file couldn't be read or written
no-vault = there's no vault yet
no-music-folder = the music folder isn't there
duplicate-playlist = a playlist already has that name
unnamed-playlist = it needs a name
not-a-folder = that isn't a folder
root-inside-root = that folder is already in the library
not-a-root = that folder isn't in the library
not-a-playlist-file = that file isn't a playlist Resonate can read
autoeq-unreachable = AutoEq couldn't be reached
autoeq-refused = AutoEq turned the request down
autoeq-unreadable = AutoEq's answer couldn't be read
profile-store = the profile file couldn't be read or written
not-a-profile = that file isn't an equaliser profile
no-such-profile = that profile isn't kept any more
name-not-usable = that name can't be used for a profile
too-large = the file is too large
too-many-lines = the file holds too many lines
measurement-too-large = the file is too large to be a measurement
no-measured-points = no line of that file reads as a frequency and a level
too-few-measured-points = that file holds too few points
misses-the-mid-band = the measurement and its target must both reach from 500 Hz to 2 kHz
nothing-to-correct = that measurement already sits on its target
not-found = Couldn't find “{ $title }” — it may have been moved or deleted
unsupported = “{ $title }” is in a format Resonate can't play
damaged = Couldn't play “{ $title }” — the file looks damaged
cannot-seek-in = Couldn't jump around in “{ $title }”
waits-for-a-device = No speakers or headphones to play through — playing on once one is there
waits-for-the-device = The audio device stopped playing — playing on once one is there
could-not-open = That track couldn't be opened
cannot-seek = This track can't be skipped through
nothing-playing = Nothing is playing right now
nothing-queued = There's nothing in the queue to play
no-device = No speakers or headphones to play through
device-gone = The audio device was unplugged or switched off
sound-server = Lost touch with the sound system — trying again
device-refused = The audio device wouldn't play this track's format
queue-moved = The queue changed before that could happen
player-stopped = The player stopped responding — restart Resonate
a-track-not-found = A track couldn't be found
a-track-unsupported = A track is in a format Resonate can't play
a-track-damaged = A track couldn't be played
held-by-another-zone = Another zone plays that device bit-perfect
zone-refused = That zone is no longer there
not-handed-over = The other zone didn't take the playback over
nothing-to-compare = The two sides of the listening test can't be told apart here
