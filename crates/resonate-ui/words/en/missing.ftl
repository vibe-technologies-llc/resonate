nothing-missing = Nothing missing
nothing-matches = Nothing missing matches
nothing-short-matches = No missing track or release matches this search.
whole = Every release the library knows of is whole.
look-it-up = Look up the library from Settings › Online to learn what its releases are short of.
dismiss-release-hint = Take this release off the Missing list
bring-back-hint = List every track and release dismissed from here again
tracks-missing-from-albums = { $tracks ->
    [one] { $tracks } track
   *[other] { $tracks } tracks
} missing from { $albums ->
    [one] { $albums } album
   *[other] { $albums } albums
}
releases-by-artists-not-held = { $releases ->
    [one] { $releases } release
   *[other] { $releases } releases
} by { $artists ->
    [one] { $artists } artist
   *[other] { $artists } artists
} not held
missing = Missing
bring-back = Bring back { $count } dismissed
tracks = Tracks
releases = Releases
missing-from-album = { $count } missing
releases-unheld = { $count ->
    [one] { $count } release
   *[other] { $count } releases
}
disc = Disc { $disc }
disc-eyebrow = DISC { $disc }
tracks-listed-short = { $listed } of { $counted } tracks listed; type to narrow to the rest
releases-listed-short = { $listed } of { $counted } releases listed; type to narrow to the rest
