moving-reaching = Drag a row to where it should play. Reach a row — { $reach-above } or { $reach-below }. Reach more of them — { $widen-above } or { $widen-below }
moving-further = Reach further — { $reach-first }, { $reach-last }, { $reach-page-above } or { $reach-page-below }. Reach every row — { $reach-everything }
moving-acting = Move what is reached — { $raise-row } or { $lower-row }. Play it — { $play-reached }. Take it away — { $drop-reached }. Open its menu — menu or { $open-menu }. Reach every row between — shift-click
moving-hint = { $reaching }. { $further }. { $acting }
one-place-sooner = Play what is reached one place sooner — { $keys }
one-place-later = Play what is reached one place later — { $keys }
titled-and-more = { $title } and { $more } more
and-more = and { $more } more
