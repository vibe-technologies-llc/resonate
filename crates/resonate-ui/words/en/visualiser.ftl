hold = Hold the picture still
resume-moving = Set the picture moving again
nothing-playing = Nothing playing
play-to-draw = Play a track and the visualiser draws what is heard.
marked = Nothing to draw
marked-more = A DSD stream sent as DoP carries markers rather than samples. Turn DoP off under Output and the pane draws the stream decimated to PCM.
reads-hint = What reaches the device — after the equaliser, the volume and the dither — drawn as it is heard rather than as it is decoded. The spectrum is { $width } bands, { $tilt }, falling back slowly with each band's peak held above it.
spectrum-hint = { $width } bands from 20 Hz to what the rate carries, with each band's peak held
scope-hint = The waveform, left over right, held still on a rising edge of the mid, or of the side where that is the louder
stereo-hint = Where the sound stands between the speakers: a goniometer, mid up and side across, beside each channel's level and how alike the two are
level-hint = Each channel's loudness over the last moment, its true peak held above it: read between the samples, so an over a DAC's reconstruction would make shows past full scale
correlation-hint = How alike the two channels are: +1 the same sound in each, 0 unrelated, below 0 out of phase
third-octave = third-octave
sixth-octave = sixth-octave
twelfth-octave = twelfth-octave
third-octave-opening = Third-octave
sixth-octave-opening = Sixth-octave
twelfth-octave-opening = Twelfth-octave
untilted = each drawn at the level it reads
tilted-pink = tilted up { $decibels } dB an octave about 1 kHz so that pink noise stands level
tilted = tilted up { $decibels } dB an octave about 1 kHz
spectrum = Spectrum
scope = Scope
stereo = Stereo
points-read = { $points }-point · { $rate } kHz
span-read = { $millis } ms · { $rate } kHz
true-peak = { $channel } { $peak } dBTP
left-channel = L
right-channel = R
correlation-unknown = correlation —
correlation = correlation { $held }
resume = Resume
pause = Pause
