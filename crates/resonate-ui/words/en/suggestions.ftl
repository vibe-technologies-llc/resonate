nothing-offered = Nothing to suggest yet
scan-more = Scan more music, and the lists it can fill itself appear here.
play-hint = Play what this list would hold, in order
shuffle-hint = Play what this list would hold, shuffled
queue-hint = Queue what this list would hold after what is already queued, ahead of the rest of what is playing
save-hint = Keep this as a playlist that fills itself
saved-hint = A playlist already fills itself from this search
open-hint = See what this list would hold
search-hint = Put this list's search in the search box and see it in the tracks pane
back-hint = Back to every suggestion
suggestions = Suggestions
suggestion-of = Suggestion · { $kind }
play = Play
shuffle = Shuffle
first-shown = { $whole } · the first { $shown } shown
lists = { $count ->
    [one] { $count } list
   *[other] { $count } lists
}
tracks = { $count ->
    [one] { $count } track
   *[other] { $count } tracks
}
