offering = Offrant le catalogue sur le réseau depuis le port { $port } comme { $udn }
holds = Il tient { $songs ->
    [one] { $songs } chanson
   *[other] { $songs } chansons
}, { $albums ->
    [one] { $albums } album
   *[other] { $albums } albums
}, { $artists ->
    [one] { $artists } artiste
   *[other] { $artists } artistes
} et { $playlists ->
    [one] { $playlists } Liste de lecture
   *[other] { $playlists } Listes de lecture
}
stopped = Arrêt de l’offre du catalogue
