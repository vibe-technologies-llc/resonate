help-hearing = a entendre A b entendre B x entendre X
help-answering = 1 X est A 2 X est B q quitter ? cette aide
trial = procès { $number } de { $planned }
levels-matched = les niveaux correspondants à { $residual } dB; { $trial }
one-level-played = A et B jouent à un niveau; { $trial }
one-level-measured = A et B mesurés à un niveau; { $trial }
louder-lowered = le bras plus fort est abaissé de { $by } dB pour correspondre à l’autre; { $trial }
right = droite
wrong = faux
none-answered = Aucun procès n’a été répondu
stopped-after = arrêté après { $answered } { $planned ->
    [one] { $planned } procès
   *[other] { $planned } procès
}
heard-it = qui est peu susceptible d’être de la chance: vous pouvez entendre ceci
luck = qui pourrait bien être de la chance: aucune différence n’a été montrée
scored = { $right } de { $answered } droite, chance de cela en devinant { $percent }% (p = { $p })
measuring = mesurer à quel point A et B jouent la chanson, pour les égaler
failed = { $track } échoué
rejected = { $command } rejeté
hearing = audience { $arm }
