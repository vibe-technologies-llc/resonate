exported = { $count ->
    [one] { $file } a écrit une écoute.
   *[other] écrit { $count } écoute { $file }
}
brought-so-far = { $credited } compté, { $held } tenu déjà, { $unmatched } de chansons non tenues ici
brought-in = { $credited } de { $service }: { $held } ont déjà eu lieu, et { $unmatched } ne nom pas de chant tenu ici, qu’une dernière fois, il est
brought-in-from-file = { $credited } de { $file }: { $held } ont déjà eu lieu, et { $unmatched } ne nom pas de chant tenu ici, qu’une dernière fois, il est
