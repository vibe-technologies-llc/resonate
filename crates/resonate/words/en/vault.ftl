released = released { $released } | kept { $stranded } the vault holds the only copy of
would-release = would release { $released } | kept { $stranded } the vault holds the only copy of
nothing-released = nothing was released; --apply makes it so
prune-after = resonate vault --prune takes away what nothing names any more
compacted = covers { $covers } | were { $was } | now { $now } | saved { $saved } | left as JPEGs { $kept } | failed { $left }
would-compact = would swap covers { $covers } | were { $was } | now { $now } | saved { $saved } | left as JPEGs { $kept } | failed { $left }
nothing-swapped = nothing was swapped; --apply makes it so
root = root { $root }
holds-nothing = the vault holds nothing yet; resonate vault --import says what it would take
form = FORM
objects = OBJECTS
held = HELD
sources = SOURCES
saved = SAVED
holdings = objects { $objects } | held { $held } | sources { $sources } | saved { $saved } | covers { $covers } | pictures { $pictures }
unvalidated = unvalidated { $unvalidated } | named by nothing { $loose }
weighed-again = { $form }, weighed again
file = FILE
was = WAS
now = NOW
codec = CODEC
size = SIZE
would-be-kept-as = WOULD BE KEPT AS
already-held = already held
more = and { $more } more
nothing-to-import = nothing to import
passed-over = passed over { $file }: it { $why }
imported = kept { $kept } | already held { $deduped } | covers { $covers } | passed over { $passed } | sources { $sources } | held { $held } | saved { $saved }
covers-not-kept = covers the vault could not keep { $covers }
would-keep = would keep { $walked } | of them weighed again under this build's encoder { $renewing }
nothing-written = nothing was written; pass --apply to do it
nothing-to-weigh = the vault holds nothing to weigh
did-not-read-back = did not read back as what went in: { $path }
not-weighed = could not be read, so it was not weighed: { $path } ({ $error })
weighed = weighed { $weighed } | held { $held } | moved { $moved } | covers weighed { $covers } | covers held { $covers_held } | covers moved { $covers_moved } | unreached { $unreached }
mended = mended: tracks pointed back at their own files { $released } | tracks the vault holds the only copy of { $stranded } | albums letting go of a cover { $let_go }
nothing-mended = nothing was mended; --apply points each track back at its own file and lets the covers go
unframed = packed as one frame by an earlier build, so a seek back in one starts it over: { $unframed }; --apply repacks them in frames
did-not-repack = did not repack as what went in: { $path }
repacked = repacked in frames { $repacked } of the { $unframed } packed as one frame
pruned = objects { $objects } | covers { $covers } | staged { $staged } | left { $left }
would-prune = would take objects { $objects } | covers { $covers } | staged { $staged } | left { $left }
nothing-taken = nothing was taken away; --apply makes it so
