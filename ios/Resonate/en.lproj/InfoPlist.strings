"CFBundleDisplayName" = "Resonate";
"NSLocalNetworkUsageDescription" = "Resonate finds your other devices on this network and keeps them in step, sending songs directly between them, plays to the streamers and amplifiers you choose on it, and offers your music to them when you turn that on.";
